# ── Site URL (required for SEO / sitemap / Open Graph) ───────────────
# Use your real production domain so Google indexes the right host.
# Local: http://localhost:3000
# Vercel preview/prod: https://cv-jungle.vercel.app (not localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing controls:
# - localhost and *.vercel.app preview URLs are NOT indexed by default
# - Set NEXT_PUBLIC_SEO_INDEX=true only on your real custom domain deploy
# NEXT_PUBLIC_SEO_INDEX=false

# Google Search Console HTML tag verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Secondary IP caps (burst protection)
RATE_LIMIT_PARSE_PER_HOUR=20
RATE_LIMIT_LLM_PER_HOUR=6
RATE_LIMIT_LLM_PER_DAY=6

# ── LLM provider (pick ONE) ──────────────────────────────────────────
# openai | groq | google | ollama
LLM_PROVIDER=groq

# Optional override (defaults depend on provider — see lib/ai)
# Groq free default: llama-3.3-70b-versatile
# LLM_MODEL=llama-3.3-70b-versatile

# ── Groq (recommended free testing) ──────────────────────────────────
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=

# ── Google Gemini (also free tier) ───────────────────────────────────
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_GENERATIVE_AI_API_KEY=

# ── Ollama (fully free, runs on your machine) ────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ── OpenAI (paid) ────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ── Demo mode (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DEMO=false
