# ── Site URL (required for SEO / sitemap / Open Graph) ───────────────
# Use your real production domain so Google indexes the right host.
# Example: https://cvjungle.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing controls:
# - localhost and *.vercel.app preview URLs are NOT indexed by default
# - Set NEXT_PUBLIC_SEO_INDEX=true only on your real custom domain deploy
# - Or set NEXT_PUBLIC_SEO_INDEX=false to force noindex
# NEXT_PUBLIC_SEO_INDEX=true

# Google Search Console (https://search.google.com/search-console):
# 1) Add property for your domain
# 2) Choose HTML tag verification → paste the content= value below
# 3) Submit sitemap: https://YOUR_DOMAIN/sitemap.xml
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Free MVP rate limits (per IP, in-memory) ──────────────────────────
# LLM actions = analyze + rewrites (+ rare structure fallback)
RATE_LIMIT_PARSE_PER_HOUR=40
RATE_LIMIT_LLM_PER_HOUR=15
RATE_LIMIT_LLM_PER_DAY=40

# ── LLM provider (pick ONE) ──────────────────────────────────────────
# openai | groq | google | ollama
LLM_PROVIDER=groq

# Optional override (defaults depend on provider — see lib/ai)
# Groq free default: llama-3.3-70b-versatile
# (JSON is produced via text+parse in lib/ai/generate-structured.ts — any chat model works)
# LLM_MODEL=llama-3.3-70b-versatile

# ── Groq (recommended free testing) ──────────────────────────────────
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=

# ── Google Gemini (also free tier) ───────────────────────────────────
# Free API key: https://aistudio.google.com/apikey
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_GENERATIVE_AI_API_KEY=

# ── Ollama (fully free, runs on your machine) ────────────────────────
# 1) Install: https://ollama.com
# 2) ollama pull llama3.2
# 3) ollama serve
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ── OpenAI (paid) ────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ── Demo mode (optional) ─────────────────────────────────────────────
# Shows "Try with Demo Data" on upload. Off by default for real users.
NEXT_PUBLIC_ENABLE_DEMO=false
